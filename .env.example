# Port the server listens on (Render sets this automatically in production)
PORT=3000

# Which AI provider to use: "anthropic", "openai", or "gemini".
# Leave blank / unset to run with the AI disabled (site still loads, chat shows a friendly config message).
AI_PROVIDER=anthropic

# --- Anthropic (Claude) — used when AI_PROVIDER=anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- OpenAI — used when AI_PROVIDER=openai ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Google Gemini — used when AI_PROVIDER=gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# ===========================================================================
# Accounts (optional)
#
# H1 works with no database at all: everything is stored on the device, exactly
# as it always has been, and the sign-in screen is never shown. Setting
# DATABASE_URL turns on accounts — sign-in, and work that follows a student to
# their other devices.
# ===========================================================================

# A PostgreSQL connection string. Any Postgres works (Neon, Supabase, Render
# Postgres, a local server). With this set, accounts are available.
#   postgresql://user:password@host:5432/dbname
# Without it, and outside production, H1 uses a local PostgreSQL-in-WebAssembly
# database in ./.data/h1-db so accounts can be developed against with no setup.
DATABASE_URL=

# Set to "no-verify" only if your provider uses a self-signed certificate.
DATABASE_SSL=

# Maximum number of PostgreSQL connections (default 10).
DATABASE_POOL_MAX=

# Use a local PGlite database at this path instead of DATABASE_URL.
# "memory://" keeps it in memory, which is what the tests use.
H1_DATABASE_PATH=

# How long a session survives without being used, and how long it lasts no
# matter what. Defaults: 7 and 30 days.
SESSION_IDLE_DAYS=
SESSION_MAX_DAYS=

# How often using a session pushes its idle deadline back (default 300 seconds).
# Lower means more database writes for no real benefit; it exists so session
# expiry can be tested without waiting a week.
SESSION_TOUCH_SECONDS=

# Whether the session cookie is marked Secure. Defaults to on in production,
# off in local development (where there's no HTTPS). Only set this to "false"
# in production if you know exactly why.
COOKIE_SECURE=

# Extra origins allowed to make signed-in requests, comma separated. H1's pages
# and its API share one origin, so this is normally left empty.
ALLOWED_ORIGINS=

# How many proxies sit in front of H1, for reading the visitor's real IP address
# (used by the sign-in rate limiter). Defaults to 1 in production, 0 locally.
TRUST_PROXY=

# H1's own account ("Pranav-H1"). It is created from these on start-up, and is
# exempt from the usual username/password rules. Set ONE of them:
#   H1_MASTER_PASSWORD_HASH — preferred. Generate with:  node scripts/hash-password.js
#   H1_MASTER_PASSWORD      — the plain password; hashed on start-up.
# Never commit either one. Leave both unset and the account simply isn't created.
H1_MASTER_PASSWORD_HASH=
H1_MASTER_PASSWORD=

# How much each account may store (megabytes). Defaults: 50 and 150.
ACCOUNT_DATA_QUOTA_MB=
ACCOUNT_FILES_QUOTA_MB=

# How many AI Tutor messages an account (or a device with no account) may send in
# a rolling 24 hours. Default 68. H1's own account is never counted. Once a
# database is set up, the creator can change this from inside H1 and that value
# wins over this one.
AI_MESSAGE_LIMIT=
